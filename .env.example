# ===== 服务监听 =====
# 端口与监听地址（HOST=127.0.0.1 表示只允许本机/反向代理访问，更安全）
PORT=8787
HOST=0.0.0.0

# ===== Gemini API Key（服务端统一提供，客户端可以不再传 Key）=====
# 多个 Key 用英文逗号分隔，会自动随机/轮询做负载均衡
GEMINI_API_KEYS=AIzaSyXXXXXXXX_key1,AIzaSyYYYYYYYY_key2

# 负载均衡策略：random（默认，随机）| round-robin（轮询）
KEY_STRATEGY=random

# ===== 访问令牌（可选但强烈建议）=====
# 设置后，客户端必须携带该令牌才能使用本代理（避免你的 VPS 被陌生人白嫖）
# 携带方式：Authorization: Bearer <令牌> / x-goog-api-key: <令牌> / ?token=<令牌>
# PROXY_TOKEN=

# ===== 上游（一般无需修改）=====
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_VERSION=v1beta
# VERIFY_MODEL=gemini-2.5-flash
# /v1/embeddings（OpenAI 兼容）默认使用的向量模型，客户端传 OpenAI 模型名时会被映射到它
# EMBEDDINGS_MODEL=gemini-embedding-2
# 上游连接与响应头等待超时（毫秒），流式响应开始后不受该超时限制
# UPSTREAM_TIMEOUT_MS=600000

# ===== 日志 =====
# LOG_REQUESTS=false 可关闭每条请求的访问日志
# LOG_REQUESTS=true
# DEBUG=true 打印详细调试日志（含请求体结构、上游响应头等）
# DEBUG=false
